{
  "name": "@lopsy/handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The handoff protocol between Lopsy Photos and Lopsy: message types, validators and both ends of the postMessage handshake. Plain TypeScript, no React.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "eslint": "9.37.0",
    "globals": "15.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "4.0.18"
  }
}
