{
  "name": "@lopsy/photos-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lopsy Photos: storage adapters (Google Drive, local folder, memory), the library database and import. Plain TypeScript, no React.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "eslint": "9.37.0",
    "globals": "15.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "4.0.18"
  }
}
