{
  "name": "@lopsy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The UI both apps share: design tokens, reset and fonts, the shared components and accessibility helpers. TypeScript and CSS Modules source, consumed directly.",
  "exports": {
    "./styles/*": "./src/styles/*",
    "./Slider": "./src/Slider/Slider.tsx",
    "./Menu": "./src/Menu/Menu.tsx",
    "./ZoomReadout": "./src/ZoomReadout/ZoomReadout.tsx",
    "./StatusBar": "./src/StatusBar/StatusBar.tsx",
    "./a11y/*": "./src/a11y/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@storybook/react-vite": "10.2.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "28.1.0",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
