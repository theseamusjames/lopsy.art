node_modules
dist
.context

# Secrets never belong in this public repo. Credentials live outside it
# (e.g. ~/.config/lopsy/r2.env); these patterns are a backstop.
.env
.env.*
*.env

# Tutorial projects live in R2 (npm run tutorial:upload), never in git.
apps/lopsy-web/tutorials/**/*.lopsy
*.local
.DS_Store
storybook-static

# Rust build artifacts
engine/target/
apps/lopsy-web/src/engine-wasm/pkg/
apps/lopsy-web/src/engine-wasm/pkg-wgpu/

# Playwright test artifacts
test-results/
# Engine-output checkpoints from npm run parity:record / parity:check
.parity/
# Step screenshots the parity compositions write on every run
apps/lopsy-web/e2e/screenshots/comp2-*.png
apps/lopsy-web/e2e/screenshots/koi-fish-*.png
engine/test-output/
apps/lopsy-web/tests/screenshots/

.claude/worktrees

# Local-only test samples (large RAF, kept out of the repo)
/samples
/samples/
apps/lopsy-web/public/test-sample.raf
apps/lopsy-web/e2e/screenshots/raf-import-error.png
apps/lopsy-web/e2e/screenshots/raf-import.png
apps/lopsy-web/e2e/screenshots/photos-handoff-*.png
apps/lopsy-web/e2e/screenshots/photos-grade-*.png
# Composition-run outputs (the run log, compositions/LAST_RUN.md, stays tracked)
apps/lopsy-web/compositions/*.lopsy
apps/lopsy-web/compositions/*.png
