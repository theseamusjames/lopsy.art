node_modules
dist
.context

# Secrets never belong in this public repo. Credentials live outside it
# (e.g. ~/.config/lopsy/r2.env); these patterns are a backstop.
.env
.env.*
*.env

# Tutorial projects live in R2 (npm run tutorial:upload), never in git.
tutorials/**/*.lopsy
*.local
.DS_Store
storybook-static

# Rust build artifacts
engine-rs/target/
src/engine-wasm/pkg/

# Playwright test artifacts
test-results/
# Engine-output checkpoints from npm run parity:record / parity:check
.parity/
# Step screenshots the parity compositions write on every run
e2e/screenshots/comp2-*.png
e2e/screenshots/koi-fish-*.png
engine-rs/test-output/
tests/screenshots/

.claude/worktrees

# Local-only test samples (large RAF, kept out of the repo)
/samples
/samples/
public/test-sample.raf
e2e/screenshots/raf-import-error.png
e2e/screenshots/raf-import.png
# Composition-run outputs (the run log, compositions/LAST_RUN.md, stays tracked)
compositions/*.lopsy
compositions/*.png
