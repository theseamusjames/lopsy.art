# Photonamous build settings. Copy to apps/photonamous/.env.local (git
# ignores it) and fill in what you use; every value is optional. These are
# public identifiers that ship in the page, not secrets.
# Setup: docs/photonamous-setup.md.

# OAuth client ID (Web application). Without it the start screen offers
# only "This browser" and "A folder on this computer".
VITE_GOOGLE_CLIENT_ID=

# Google Picker API key, restricted by HTTP referrer (Add from Google Drive).
VITE_GOOGLE_API_KEY=

# The Cloud project number; the Picker's app ID.
VITE_GOOGLE_APP_ID=

# Where Lopsy runs, for handoffs. Only its origin is trusted. Default:
# http://localhost:5173/ in development, https://lopsy.art/ in a build.
VITE_LOPSY_URL=
