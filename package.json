{
  "name": "lopsy",
  "version": "0.1.0",
  "private": true,
  "description": "Lopsy: a browser-based image editor (apps/lopsy-web), Photonamous (apps/photonamous, proof of concept) and the engine they render with (engine)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "wasm:build": "npm run wasm:build -w lopsy-web --",
    "wasm:build:wgpu": "npm run wasm:build:wgpu -w lopsy-web --",
    "wasm:build:dev": "npm run wasm:build:dev -w lopsy-web --",
    "wasm:build:noopt": "npm run wasm:build:noopt -w lopsy-web --",
    "wasm:test": "npm run wasm:test -w lopsy-web --",
    "wasm:test:wgpu": "npm run wasm:test:wgpu -w lopsy-web --",
    "wasm:size": "npm run wasm:size -w lopsy-web --",
    "wgsl:check": "npm run wgsl:check -w lopsy-web --",
    "perf:load": "npm run perf:load -w lopsy-web --",
    "dev": "node scripts/dev.mjs",
    "dev:lopsy": "npm run dev -w lopsy-web --",
    "dev:photonamous": "npm run dev -w photonamous --",
    "build": "npm run build -w lopsy-web --",
    "build:photos": "npm run build -w photonamous --",
    "serve:photos": "node scripts/serve-site.mjs --dir apps/photonamous/dist",
    "preview": "npm run preview -w lopsy-web --",
    "test": "npm run test -w lopsy-web --",
    "test:ui": "npm run test -w @lopsy/ui",
    "test:photos": "npm run test:ui && npm run test -w @lopsy/photos-core && npm run test -w photonamous",
    "test:watch": "npm run test:watch -w lopsy-web --",
    "test:e2e": "npm run test:e2e -w lopsy-web --",
    "test:e2e:photos": "npm run test:e2e -w photonamous --",
    "test:e2e:site": "VITE_LOPSY_URL= VITE_GOOGLE_CLIENT_ID= VITE_GOOGLE_API_KEY= VITE_GOOGLE_APP_ID= npm run build:photos && (npm exec -w photonamous -- playwright test -c playwright.site.config.ts; status=$?; rm -rf apps/photonamous/dist; exit $status)",
    "parity:record": "npm run parity:record -w lopsy-web --",
    "parity:check": "npm run parity:check -w lopsy-web --",
    "tutorial:upload": "npm run tutorial:upload -w lopsy-web --",
    "tutorial:check": "npm run tutorial:check -w lopsy-web --",
    "typecheck": "npm run typecheck -w lopsy-web --",
    "typecheck:ui": "npm run typecheck -w @lopsy/ui",
    "typecheck:photos": "npm run typecheck:ui && npm run typecheck -w @lopsy/photos-core && npm run typecheck -w photonamous",
    "lint": "npm run lint -w lopsy-web --",
    "lint:ui": "npm run lint -w @lopsy/ui",
    "lint:photos": "npm run lint:ui && npm run lint -w @lopsy/photos-core && npm run lint -w photonamous",
    "storybook": "npm run storybook -w lopsy-web --",
    "build-storybook": "npm run build-storybook -w lopsy-web --",
    "storybook:photos": "npm run storybook -w photonamous --",
    "build-storybook:photos": "npm run build-storybook -w photonamous --"
  }
}
